# ============================================
# 敏感数据和配置文件
# ============================================
# 环境变量文件（包含敏感信息）
.env
.env.local
.env.*.local

# YAML 数据文件（包含运行时生成的敏感数据）
test_data/extract.yaml
test_data/bid_generate.yaml
test_data/*.yaml
!test_data/*.example.yaml

# 配置文件（可能包含敏感信息）
conf/server.ini
conf/*.local

# HAR分析配置文件（包含API密钥）
test_data/har/har_analysis_config.yaml
!test_data/har/har_analysis_config.example.yaml

# 评估配置文件（包含API密钥）
test_data/evaluation/evaluation_config.yaml
!test_data/evaluation/evaluation_config.example.yaml

# ============================================
